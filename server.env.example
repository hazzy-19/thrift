# Copy this file to server-secrets/.env.local and enter rotated server secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS backend URL. Leave empty locally to use polling automatically.
TELEGRAM_WEBHOOK_URL=
# Required for announcement management. Use /whoami to discover an ID.
TELEGRAM_ALLOWED_CHAT_IDS=
FRONTEND_ORIGINS=http://localhost:5173
# PostgreSQL stores authenticated carts. Guest carts remain in browser local storage.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/thrifter
# Redis is only for rate limits, OTPs, sessions, short-lived cache, and job queues.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Firebase project ID is sufficient for ID-token verification.
FIREBASE_PROJECT_ID=
# Optional server-only Firebase Admin service-account JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=server-secrets/firebase-service-account.json
# Temporary SQLite path used only by the Telegram announcement feature.
DATABASE_PATH=
